{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuvora",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SHOPIFY_CLIENT_ID": "fef6dbefd0002e86415309a329c54635",
    "SHOPIFY_SHOP": "hjrcnd-rs.myshopify.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/"
    ]
  }
}